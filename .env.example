# Shishoza — local configuration template.
# Copy this file to `.env` (which is gitignored) and fill in your values.
# Everything here is OPTIONAL: with nothing set, the app runs fine and email
# notifications are simply skipped (citizens still see outcomes in "My requests").

# ── Email notifications (Gmail SMTP is free) ──────────────────────────────
# SMTP_USER = your Gmail address
# SMTP_PASS = a 16-character Google "App Password" (NOT your normal password;
#             requires 2-Step Verification on: https://myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=

# Optional overrides:
# SMTP_FROM=Shishoza <no-reply@shishoza.rw>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# PUBLIC_URL=https://kerie1-shishoza.hf.space   # link used in the notification email

# ── Persistent monitoring (optional; Google Sheet is free) ────────────────
# A Google Apps Script Web App URL. When set, every prediction is appended to
# your Google Sheet as well as the local CSV, so the monitoring log survives
# container restarts in deployment. Leave blank to log only to the local CSV.
# MONITOR_WEBHOOK_URL=https://script.google.com/macros/s/AKfy.../exec

# ── Live Earth Engine (optional; enables live-imagery parcel analysis) ────
# Without this, the app still runs but uses the fast nearest-sample fallback
# instead of live satellite imagery. To turn live mode on in deployment, paste
# a Google Cloud service-account key (the whole JSON, on one line) here:
# EE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# EE_PROJECT=vocal-orbit-490015-m2   # your Earth-Engine-registered GCP project
#
# How to get the key: in Google Cloud Console, on your EE-registered project,
# create a service account, register it for Earth Engine, then add a JSON key
# (Keys → Add key → JSON). On Hugging Face, set it under
# Space → Settings → Variables and secrets → New secret (name EE_SERVICE_ACCOUNT_JSON).
# Locally you can instead run `earthengine authenticate` and leave this blank.

# ── Other optional settings ───────────────────────────────────────────────
# LIVE_EE_TIMEOUT_S=15         # cap on the live Earth Engine pull (seconds)
# LIVE_CACHE_TTL_S=432000      # how long a live pull stays cached (default 5 days)
# SHISHOZA_SECRET=change-me    # Flask session signing key for production
