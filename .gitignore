scripts/revert8_and_ethics.py
scripts/rewrite_descriptions.py
# supervisor-doc generators (not reproducible-pipeline steps)
scripts/make_supervisor_doc.py
scripts/make_supervisor_ppt.py

# ── Not part of the deliverable / kept local ────────────────────────────────
# AI-tool config, not a project artifact
CLAUDE.md
.claude/
# running feature log — local reference only
FEATURES.md
# one-off notebook builders (not runtime, not the reproducible pipeline)
scripts/append_national_sections.py
scripts/build_national_notebook.py
# stray backup artifact
results/application/sector_risk_labelavg_backup.json
# dissertation writing + its one-off Word/figure generators (kept local)
Chapter4_System_Implementation_and_Testing.md
REPORT_UPDATES_new_features.md
scripts/build_chapter4_docx.py
scripts/build_chapters_5_6_docx.py
scripts/make_clearance_map.py

# ── Derivative bundle (regenerable from results/) ──────────────────
ml_deliverables/

# ── Model binaries — all *.pkl tracked via Git LFS (.gitattributes) ────
# rf_D_tuned.pkl is NOT deployed and NOT LFS-tracked — regenerable by running
# scripts/hyperparameter_tune.py. All other pkl files are LFS-tracked.
models/rf_D_tuned.pkl

# ════════════════════════════════════════════════════════════════════
#  Runtime / generated data — regenerable on demand
# ════════════════════════════════════════════════════════════════════
# SQLite DB — anyone cloning runs scripts/seed_users.py to rebuild
data/database/treesight.db

# Temporary upload working directory (citizens uploading cadastral PDFs)
data/raw/external/_uploads/

# Debug PNGs that the cadastral OCR pipeline may emit during dev
data/raw/external/bug_*.png
data/raw/external/cad_*.png
data/raw/external/cad_*.txt
data/raw/external/bugesera_*.png

# Temporary task / log output
/tmp/
*.log
treesight.log

